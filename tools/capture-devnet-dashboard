#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
PROM_IMAGE='prom/prometheus@sha256:4f6c47e39a9064028766e8c95890ed15690c30f00c4ba14e7ce6ae1ded0295b1'
GRAFANA_IMAGE='grafana/grafana@sha256:b7fcb534f7b3512801bb3f4e658238846435804deb479d105b5cdc680847c272'
OWNER='base-control-dashboard-capture'

usage() { echo "usage: $0 {start|capture|stop} RUN_DIR" >&2; exit 2; }
[[ $# == 2 ]] || usage
ACTION=$1
RUN_DIR=$(realpath "$2")
RUNTIME="$RUN_DIR/runtime.json"
LOG="$RUN_DIR/launcher.log"
[[ -f $RUNTIME && -f $LOG ]] || { echo "RUN_DIR must contain runtime.json and launcher.log" >&2; exit 2; }
RUN_ID=$(basename "$RUN_DIR")
STATE="$ROOT/target/dashboard-capture/$RUN_ID"
PROM_NAME="base-control-prometheus-$RUN_ID"
GRAFANA_NAME="base-control-grafana-$RUN_ID"

owned_remove() {
  local name=$1 id owner
  id=$(docker ps -aq --filter "name=^/${name}$")
  [[ -z $id ]] && return
  owner=$(docker inspect -f '{{index .Config.Labels "dev.base.capture.owner"}}' "$id")
  [[ $owner == "$OWNER" ]] || { echo "refusing to remove unrelated container $name" >&2; exit 1; }
  docker rm -f "$id" >/dev/null
}

discover() {
  [[ $(jq -r .status "$RUNTIME") == ready ]] || { echo "runtime is not ready" >&2; exit 1; }
  mapfile -t METRICS < <(sed -n 's/.*Starting metrics endpoint at 127\.0\.0\.1:\([0-9]*\).*/\1/p' "$LOG" | head -2)
  [[ ${#METRICS[@]} == 2 ]] || { echo "expected exactly two initial EL metrics endpoints in launcher.log" >&2; exit 1; }
  BUILDER_RPC=$(jq -r '.builder_rpc_url | capture(":(?<port>[0-9]+)/?$").port' "$RUNTIME")
  VERIFIER_RPC=$(jq -r '.verifier_rpc_url | capture(":(?<port>[0-9]+)/?$").port' "$RUNTIME")
  mapfile -t RPC_LOG < <(sed -n 's/.*RPC HTTP server started url=127\.0\.0\.1:\([0-9]*\).*/\1/p' "$LOG" | head -2)
  [[ ${RPC_LOG[*]} == "$BUILDER_RPC $VERIFIER_RPC" ]] || { echo "runtime RPC fields do not match launcher startup order" >&2; exit 1; }
  for port in "$BUILDER_RPC" "$VERIFIER_RPC"; do
    curl -fsS --data '{"jsonrpc":"2.0","id":1,"method":"eth_chainId","params":[]}' -H 'content-type: application/json' "http://127.0.0.1:$port" | jq -e '.result != null' >/dev/null
  done
  for port in "${METRICS[@]}"; do curl -fsS "http://127.0.0.1:$port" >/dev/null; done
}

start() {
  discover
  mkdir -p "$STATE/dashboards" "$STATE/provisioning/datasources" "$STATE/provisioning/dashboards"
  jq --arg run "$RUN_ID" --arg builder "$BUILDER_RPC" --arg verifier "$VERIFIER_RPC" \
    --arg bm "${METRICS[0]}" --arg vm "${METRICS[1]}" '
    .description = ("Live launcher telemetry for " + $run + ". Global metrics are queried once, not summed across endpoints.") |
    .panels[0].options.content = ("# 🔵 Base Control · live launcher telemetry\nRun **" + $run +
      "** · absolute UTC capture range is shown in Grafana. Builder RPC `" + $builder + "` → metrics `" + $bm +
      "`; verifier RPC `" + $verifier + "` → metrics `" + $vm +
      "`. Both ELs share the launcher process and global metrics recorder. Workload metrics are read once; unavailable HA, publication and independent per-node panels are omitted.")
    ' "$ROOT/site/media/base-control-dashboard.json" >"$STATE/dashboards/devnet.json"
  cat >"$STATE/prometheus.yml" <<EOF
global: {scrape_interval: 2s}
scrape_configs:
  - job_name: l2_builder
    static_configs: [{targets: ['127.0.0.1:${METRICS[0]}'], labels: {mapping: 'builder_rpc_${BUILDER_RPC}'}}]
  - job_name: l2_verifier
    static_configs: [{targets: ['127.0.0.1:${METRICS[1]}'], labels: {mapping: 'verifier_rpc_${VERIFIER_RPC}'}}]
EOF
  cat >"$STATE/provisioning/datasources/prometheus.yml" <<'EOF'
apiVersion: 1
datasources:
  - {name: Prometheus, type: prometheus, uid: PBFA97CFB590B2093, access: proxy, url: 'http://127.0.0.1:39090', isDefault: true, editable: false}
EOF
  cat >"$STATE/provisioning/dashboards/default.yml" <<'EOF'
apiVersion: 1
providers:
  - {name: Base Control, orgId: 1, type: file, disableDeletion: true, updateIntervalSeconds: 2, options: {path: /var/lib/grafana/dashboards}}
EOF
  owned_remove "$PROM_NAME"; owned_remove "$GRAFANA_NAME"
  docker run -d --name "$PROM_NAME" --network host --label "dev.base.capture.owner=$OWNER" --label "dev.base.capture.run=$RUN_ID" -v "$STATE/prometheus.yml:/etc/prometheus/prometheus.yml:ro" "$PROM_IMAGE" --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.retention.time=30m --web.listen-address=127.0.0.1:39090 >/dev/null
  docker run -d --name "$GRAFANA_NAME" --network host --label "dev.base.capture.owner=$OWNER" --label "dev.base.capture.run=$RUN_ID" -e GF_SERVER_HTTP_ADDR=127.0.0.1 -e GF_SERVER_HTTP_PORT=33000 -e GF_AUTH_ANONYMOUS_ENABLED=true -e GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer -e GF_USERS_DEFAULT_THEME=dark -v "$STATE/provisioning:/etc/grafana/provisioning:ro" -v "$STATE/dashboards:/var/lib/grafana/dashboards:ro" "$GRAFANA_IMAGE" >/dev/null
  local ready=false
  for _ in {1..40}; do
    if [[ $(docker inspect -f '{{.State.Running}}' "$PROM_NAME") == true && $(docker inspect -f '{{.State.Running}}' "$GRAFANA_NAME") == true ]] &&
      curl -fsS --max-time 2 http://127.0.0.1:33000/api/health >/dev/null && curl -fsS --max-time 2 http://127.0.0.1:39090/-/ready >/dev/null; then ready=true; break; fi
    sleep 1
  done
  $ready || { echo "Grafana/Prometheus did not become ready" >&2; exit 1; }
  printf 'run=%s builder_rpc=%s builder_metrics=%s verifier_rpc=%s verifier_metrics=%s\n' "$RUN_ID" "$BUILDER_RPC" "${METRICS[0]}" "$VERIFIER_RPC" "${METRICS[1]}" | tee "$STATE/mapping.txt"
}

capture() {
  discover
  for _ in {1..100}; do
    samples=$(curl -fsSG http://127.0.0.1:39090/api/v1/query --data-urlencode 'query=count_over_time(up{job=~"l2_builder|l2_verifier"}[3m])' | jq '[.data.result[].value[1]|tonumber] | min // 0')
    (( samples >= 85 )) && break
    sleep 2
  done
  (( samples >= 85 )) || { echo "insufficient scrape samples for a coherent three-minute window" >&2; exit 1; }
  curl -fsSG http://127.0.0.1:39090/api/v1/query \
    --data-urlencode 'query=up{job=~"l2_builder|l2_verifier"}' |
    jq -e --arg bm "127.0.0.1:${METRICS[0]}" --arg vm "127.0.0.1:${METRICS[1]}" '
      .data.result | length == 2 and
      (map(.metric.instance) | sort) == ([$bm,$vm] | sort) and all(.[]; .value[1] == "1")' >/dev/null
  TO_MS=$(($(date -u +%s)*1000)); FROM_MS=$((TO_MS-180000))
  mapfile -t QUERIES < <(jq -r '.panels[].targets[]?.expr | gsub("\\$__rate_interval";"1m")' "$ROOT/site/media/base-control-dashboard.json")
  tmp=$(mktemp); printf '[]' >"$tmp"
  for query in "${QUERIES[@]}"; do
    result=$(curl -fsSG http://127.0.0.1:39090/api/v1/query --data-urlencode "query=$query")
    jq -e '.status == "success" and (.data.result | length > 0) and
      all(.data.result[]; .value[1] != "NaN" and .value[1] != "+Inf" and .value[1] != "-Inf")' <<<"$result" >/dev/null
    jq --arg q "$query" --arg t "$(date -u +%FT%TZ)" --argjson r "$result" '. + [{queried_at_utc:$t,query:$q,response:$r}]' "$tmp" >"$tmp.next"; mv "$tmp.next" "$tmp"
  done
  mv "$tmp" "$ROOT/site/media/dashboard-evidence-queries.json"
  URL="http://127.0.0.1:33000/d/devnet-overview/base-devnet-control-room?orgId=1&from=$FROM_MS&to=$TO_MS&refresh="
  node "$ROOT/tools/capture-devnet-dashboard.js" "$URL" "$ROOT/site/media/base-control-dashboard.png"
  echo "captured $RUN_ID UTC $(date -u -d @$((FROM_MS/1000)) +%FT%TZ)..$(date -u -d @$((TO_MS/1000)) +%FT%TZ)"
}

case "$ACTION" in start) start;; capture) capture;; stop) owned_remove "$PROM_NAME"; owned_remove "$GRAFANA_NAME";; *) usage;; esac
